---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Jessica Kuo">
  <div class="not-found">
    <div class="not-found-code">404</div>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="btn-primary">Go Home</a>
  </div>
</Layout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    gap: 1rem;
  }
  .not-found-code {
    font-family: var(--font-mono);
    font-size: 5rem;
    font-weight: 400;
    color: var(--sage-mid);
    line-height: 1;
  }
  .not-found h1 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--forest);
  }
  .not-found p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
</style>
